# data, models and outputs stay on your computer, not GitHub
data/*
models/*
outputs/*
!data/.gitkeep
!data/download.py
!models/.gitkeep
!outputs/.gitkeep

# large data formats
*.csv
*.parquet
*.joblib
*.pkl

# Python / notebook clutter
.venv/
__pycache__/
.ipynb_checkpoints/
*.pyc
.DS_Store
*.log

# secrets: NEVER upload these
kaggle.json
.env
# keep small result tables and the bundled sample in git
!results/
!results/**
!data/sample/
!data/sample/**
